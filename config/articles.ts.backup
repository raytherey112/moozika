/**
 * ============================================================================
 * ARTICLES (SEO LANDING PAGES)
 * ============================================================================
 * Each entry becomes a page at /{slug} (e.g. /music-for-climbing) and is the
 * core of the site's SEO strategy: one page targeting one specific, low-
 * competition search term, promoting one album.
 *
 * TO ADD A NEW ARTICLE:
 *   1. Copy an entry below.
 *   2. Set a unique `slug` (this becomes the URL).
 *   3. Point `albumId` at any album in config/albums.ts.
 *   4. Pick a `heroImage` (drop a file in /public/images/heroes and reference it).
 *   5. Write a short, honest intro + 2-3 sections. Keep it concise.
 *
 * Everything else (metadata, structured data, sitemap) updates automatically.
 * ----------------------------------------------------------------------------
 */

export type ArticleSection = {
  heading: string
  body: string
}

export type ArticleFAQ = {
  question: string
  answer: string
}

export type Article = {
  /** URL path segment, e.g. "music-for-climbing" -> /music-for-climbing */
  slug: string
  /** The exact search phrase this page targets. */
  searchTerm: string
  /** Visible H1 / card title. */
  title: string
  /** <title> tag. Keep under ~60 chars. Falls back to `title` if omitted. */
  metaTitle?: string
  /** Meta description. Keep ~150-160 chars. */
  metaDescription: string
  /** Extra keywords for the meta keywords tag. */
  keywords: string[]
  /** Hero image path (in /public) + descriptive alt text. */
  heroImage: string
  heroAlt: string
  /** Album promoted on this page — must be an id from config/albums.ts. */
  albumId: string
  /** Short summary shown on homepage cards. */
  excerpt: string
  /** ISO dates used for SEO / structured data. */
  publishedAt: string
  updatedAt: string
  /** Opening paragraph shown above the article body. */
  intro: string
  /** Main article body. Keep short and accurate. */
  sections: ArticleSection[]
  /** Optional FAQ — rendered on the page and as FAQ structured data. */
  faqs?: ArticleFAQ[]
}

